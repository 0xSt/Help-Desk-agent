# ---------------------------------------------------------------------------
# Copia questo file in ".env" e valorizza ciò che ti serve.
# Senza GEMINI_API_KEY il sistema parte comunque, in modalità mock: risposte
# finte ed embedding di fallback deterministico. Utile per sviluppo e test,
# ma la qualità del retrieval non è rappresentativa.
# ---------------------------------------------------------------------------

# --- Google Gemini (LLM + embedding) ---
GEMINI_API_KEY=
# Modelli configurabili senza toccare il codice.
GEMINI_MODEL=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Dimensione dei vettori: gemini-embedding-001 ne produce 3072, troncabili
# via Matryoshka. Cambiarla forza la ricostruzione automatica dell'indice.
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32

# --- Qdrant ---
# In locale l'indice sta su disco. In Docker Compose si valorizza QDRANT_URL
# (es. http://qdrant:6333) e il client punta al servizio containerizzato.
QDRANT_PATH=qdrant_data
# QDRANT_URL=http://qdrant:6333
RETRIEVAL_TOP_K=3

# --- Soglie della logica di escalation (POL-006) ---
# 0.65 è il valore indicato testualmente da POL-006 §4.
ESCALATION_CONFIDENCE_THRESHOLD=0.65
# Soglia minima di similarità sotto la quale il retrieval è considerato senza
# appigli. DA RITARARE sui punteggi reali degli embedding Gemini: il valore
# attuale è calibrato sull'embedding di fallback ed è solo un punto di partenza.
ESCALATION_MIN_RETRIEVAL_SCORE=0.45
ESCALATION_PRECEDENT_SCORE_FLOOR=0.55
ESCALATION_PRECEDENT_RATIO=0.5

# --- MLflow (tracing ed evaluation) ---
# In Docker Compose punterà al servizio dedicato, es. http://mlflow:5000.
# Se non impostata, MLflow scrive in locale su ./mlruns.
# MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=helpdesk-agent
MLFLOW_ENABLED=true
