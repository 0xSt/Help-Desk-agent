# Copia questo file in ".env" e inserisci la tua chiave per usare Claude davvero.
# Se la lasci vuota o non crei il file .env, l'app parte comunque in modalità
# mock (risposte finte, utile per provare subito il flusso di revisione).
ANTHROPIC_API_KEY=

# Percorso della directory dove Qdrant (in modalità locale, nessun server
# esterno) salva l'indice delle due knowledge base. Facoltativo: di default
# è "qdrant_data" nella working directory del processo.
QDRANT_PATH=qdrant_data
